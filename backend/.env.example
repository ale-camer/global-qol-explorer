# Local SQLite Snapshot (default: true; falls back to BigQuery if false or missing)
PREFER_SQLITE_SNAPSHOT=true

# Google Cloud & BigQuery fallback configuration
GCP_PROJECT_ID=global-qol-explorer
BQ_DATASET=quality_of_life
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/gcp-credentials.json

# WhatsApp Ingestion Notifications (CallMeBot — unified across repos)
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
